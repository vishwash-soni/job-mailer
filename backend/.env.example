# Copy this file to ".env" and fill in your values
GROQ_API_KEY=your_groq_api_key_here

# Gmail address you send from + a Gmail "App Password" (NOT your normal password)
# Create one at: https://myaccount.google.com/apppasswords (needs 2-step verification ON)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_app_password

PORT=5000

# Frontend URL allowed to call this API (used for CORS in production)
CLIENT_URL=http://localhost:5173
